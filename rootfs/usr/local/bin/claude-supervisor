#!/usr/bin/env bash
# Runs as the claude user. Prepares Claude's config, optionally updates the CLI,
# then either runs the given command or keeps the container alive, starting and
# supervising a background Remote Control server when CLAUDE_REMOTE_CONTROL=true.
set -euo pipefail

log() { echo "[claude-container] $*"; }
is_true() { [[ "${1,,}" =~ ^(1|true|yes|on)$ ]]; }

CLAUDE_BIN="${CLAUDE_BIN:-$HOME/.local/bin/claude}"
CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
WORKSPACE="${CLAUDE_WORKSPACE:-/workspace}"
RC_LOG="/tmp/remote-control.log"
RC_PID_FILE="/tmp/remote-control.pid"

# Started with --user as another UID: fall back to a private runtime dir.
if [[ -n "${XDG_RUNTIME_DIR:-}" && ! -w "$XDG_RUNTIME_DIR" ]]; then
  XDG_RUNTIME_DIR="$(mktemp -d)"
  export XDG_RUNTIME_DIR
fi

# --- CLI updates ------------------------------------------------------------
if is_true "${CLAUDE_AUTO_UPDATE:-false}"; then
  log "CLAUDE_AUTO_UPDATE=true, updating Claude Code..."
  "$CLAUDE_BIN" update || log "WARNING: update failed, continuing with installed version"
else
  # Keep the version baked into the image; pull a newer image to upgrade.
  export DISABLE_AUTOUPDATER=1
fi
log "Claude Code $("$CLAUDE_BIN" --version 2>/dev/null || echo '(unknown version)')"

# --- Config seeding ---------------------------------------------------------
# With CLAUDE_CONFIG_DIR set, both settings and the global state file
# (.claude.json, which holds project trust) live in the persistent dir.
STATE_FILE="$CONFIG_DIR/.claude.json"
[[ -s "$STATE_FILE" ]] || echo '{}' > "$STATE_FILE"

update_json() {  # update_json <file> <jq filter> [jq args...]
  local file="$1" filter="$2" tmp; shift 2
  tmp="$(mktemp "$file.XXXXXX")"
  if jq "$@" "$filter" "$file" > "$tmp"; then mv "$tmp" "$file"; else rm -f "$tmp"; return 1; fi
}

if is_true "${CLAUDE_TRUST_WORKSPACE:-true}"; then
  # shellcheck disable=SC2016 # $ws is a jq variable
  update_json "$STATE_FILE" '.projects[$ws].hasTrustDialogAccepted = true' --arg ws "$WORKSPACE" \
    || log "WARNING: could not mark $WORKSPACE as trusted in $STATE_FILE"
fi

if [[ "${CLAUDE_PERMISSION_MODE:-default}" == "bypassPermissions" ]]; then
  # The container is the sandbox; skip the interactive "are you sure" prompt.
  SETTINGS_FILE="$CONFIG_DIR/settings.json"
  [[ -s "$SETTINGS_FILE" ]] || echo '{}' > "$SETTINGS_FILE"
  update_json "$SETTINGS_FILE" '.skipDangerousModePermissionPrompt = true' \
    || log "WARNING: could not update $SETTINGS_FILE"
fi

# --- Rust toolchain ---------------------------------------------------------
# Images with rustup keep the toolchain in the config volume (RUSTUP_HOME), so
# it is installed on the first start and reused after that.
if command -v rustup >/dev/null 2>&1; then
  toolchain="${RUST_TOOLCHAIN:-stable}"
  # rustup lives in the read-only image; the image update replaces it.
  rustup set auto-self-update disable >/dev/null 2>&1 || true
  if ! RUSTUP_AUTO_INSTALL=0 rustup run "$toolchain" rustc --version >/dev/null 2>&1; then
    log "Installing Rust toolchain '$toolchain' into $RUSTUP_HOME (first start only)..."
    rustup toolchain install "$toolchain" --profile minimal --component clippy,rustfmt \
      || log "WARNING: could not install Rust toolchain '$toolchain'; run 'rustup toolchain install $toolchain' later"
  fi
  if ! rustup default >/dev/null 2>&1; then
    rustup default "$toolchain" >/dev/null 2>&1 || true
  fi
  log "$(RUSTUP_AUTO_INSTALL=0 rustc --version 2>/dev/null || echo 'Rust: no toolchain installed')"
fi

# --- Explicit command -------------------------------------------------------
if [[ $# -gt 0 ]]; then
  cd "$WORKSPACE" 2>/dev/null || true
  exec "$@"
fi

# --- Remote Control ---------------------------------------------------------
idle() {
  sleep infinity &
  wait $!
  exit 0
}

rc_env() {
  # Remote Control needs a full claude.ai login; an API key or long-lived token
  # in the environment would take precedence and make it fail.
  env -u ANTHROPIC_API_KEY -u CLAUDE_CODE_OAUTH_TOKEN "$@"
}

logged_in_for_rc() {
  local status
  status="$(rc_env "$CLAUDE_BIN" auth status 2>/dev/null)" || return 1
  jq -e '.loggedIn == true and .authMethod == "claude.ai"' \
    <<<"$status" >/dev/null 2>&1
}

rc_accepted() {  # the CLI saves this once "Enable Remote Control?" is answered
  jq -e '.remoteDialogSeen == true' "$STATE_FILE" >/dev/null 2>&1
}

# Prints what's missing before Remote Control can run unattended. Returns 1 if
# anything is.
rc_ready() {
  local step=0 login=0 accept=0
  logged_in_for_rc || login=1
  rc_accepted || accept=1
  (( login || accept )) || return 0

  log "Remote Control is on but needs a one-time setup. Nothing is started until then."
  if (( login )); then
    log "  $((++step)). Log in with your claude.ai account (API keys and"
    log "     CLAUDE_CODE_OAUTH_TOKEN can't be used for Remote Control):"
    log "       docker compose exec -u claude claude claude auth login"
  fi
  if (( accept )); then
    log "  $((++step)). Start Remote Control once, answer 'y', then press Ctrl+C:"
    log "       docker compose exec -u claude claude claude remote-control"
  fi
  log "  $((++step)). Restart the container: docker compose restart claude"
  return 1
}

start_rc() {
  local name="${CLAUDE_RC_NAME:-$(hostname)}" args
  case "${CLAUDE_RC_MODE:-session}" in
    session)
      # One named session, started now and driven from the Claude apps.
      args=(--remote-control "$name")
      ;;
    server)
      # A server that creates sessions when you start them from the apps.
      args=(remote-control --name "$name" --spawn "${CLAUDE_RC_SPAWN_MODE:-same-dir}")
      [[ -n "${CLAUDE_RC_CAPACITY:-}" ]] && args+=(--capacity "$CLAUDE_RC_CAPACITY")
      ;;
    *)
      log "CLAUDE_RC_MODE must be 'session' or 'server', not '${CLAUDE_RC_MODE}'. Remote Control not started."
      idle
      ;;
  esac
  if [[ -n "${CLAUDE_PERMISSION_MODE:-}" && "${CLAUDE_PERMISSION_MODE}" != "default" ]]; then
    args+=(--permission-mode "$CLAUDE_PERMISSION_MODE")
  fi
  # shellcheck disable=SC2206 # intentional word splitting of user-supplied extra args
  [[ -n "${CLAUDE_RC_EXTRA_ARGS:-}" ]] && args+=(${CLAUDE_RC_EXTRA_ARGS})

  log "Starting Remote Control: claude ${args[*]} (output: $RC_LOG)"
  # `script` (util-linux, in the base image) gives the CLI a real TTY and records
  # its output. Its stdin is a FIFO we hold open, so it never sees EOF.
  script -qfec "$(printf '%q ' env -u ANTHROPIC_API_KEY -u CLAUDE_CODE_OAUTH_TOKEN "$CLAUDE_BIN" "${args[@]}")" \
    "$RC_LOG" <&3 >/dev/null 2>&1 &
  rc_pid=$!
  echo "$rc_pid" > "$RC_PID_FILE"
}

shutdown() {
  log "Stopping..."
  if [[ -n "${rc_pid:-}" ]]; then
    kill -TERM "$rc_pid" 2>/dev/null
    # Exiting now would take tini and the whole container down, SIGKILLing the
    # CLI before it can deregister and close its sessions. Let it finish.
    wait "$rc_pid" 2>/dev/null || true
  fi
  exit 0
}
trap shutdown TERM INT

rm -f "$RC_PID_FILE"  # /tmp survives `docker restart`

if ! is_true "${CLAUDE_REMOTE_CONTROL:-false}"; then
  log "Ready. Remote Control is off (CLAUDE_REMOTE_CONTROL=false)."
  log "Open a session with: docker compose exec -u claude claude claude"
  idle
fi

rc_ready || idle

cd "$WORKSPACE" 2>/dev/null || true
RC_FIFO="$(mktemp -u /tmp/remote-control.stdin.XXXXXX)"
mkfifo "$RC_FIFO"
exec 3<>"$RC_FIFO"

while true; do
  start_rc
  code=0
  wait "$rc_pid" || code=$?
  rc_pid=""
  rm -f "$RC_PID_FILE"
  log "Remote Control exited (exit code $code). See $RC_LOG"
  # Don't restart into a prompt nobody can answer (e.g. after a logout).
  rc_ready || idle
  sleep 15 &
  wait $!
  log "Restarting Remote Control..."
done
