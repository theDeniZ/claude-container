# Copy to .env and adjust. Every value is optional.

# --- Paths ------------------------------------------------------------------
# Project folder mounted at /workspace.
WORKSPACE_PATH=./workspace
# Where Claude's login, settings and sessions are kept. A name keeps them in a
# Docker volume; a path (./claude-config, /home/me/.claude-docker) uses a host folder.
CLAUDE_CONFIG_PATH=claude-config

# --- User -------------------------------------------------------------------
# Run Claude with your host UID/GID so files in the workspace stay yours.
# Find them with: id -u / id -g
PUID=1000
PGID=1000
TZ=UTC

# --- Remote Control ---------------------------------------------------------
# Start a background Remote Control server when the container starts, so you can
# drive Claude from claude.ai/code or the Claude mobile app.
# Needs a one-time `claude auth login` (claude.ai account) inside the container.
CLAUDE_REMOTE_CONTROL=false
# Name shown in the Claude apps (also the container hostname).
CLAUDE_RC_NAME=claude-container
# How new remote sessions are created: same-dir | worktree | session
CLAUDE_RC_SPAWN_MODE=same-dir
# Max concurrent remote sessions (empty = CLI default).
CLAUDE_RC_CAPACITY=
# Any other flags for `claude remote-control`.
CLAUDE_RC_EXTRA_ARGS=

# Permission mode for Remote Control sessions:
# default | acceptEdits | auto | plan | dontAsk | bypassPermissions
CLAUDE_PERMISSION_MODE=default

# --- Updates ----------------------------------------------------------------
# false: use the CLI version baked into the image (rebuilt nightly; `docker compose pull` to upgrade).
# true:  run `claude update` on every start and allow the built-in auto-updater.
CLAUDE_AUTO_UPDATE=false

# Mark /workspace as trusted so Claude doesn't stop on the trust prompt.
CLAUDE_TRUST_WORKSPACE=true

# --- Non-interactive auth (optional) ----------------------------------------
# Either of these replaces the interactive login for normal sessions.
# Neither works for Remote Control, which needs `claude auth login`.
ANTHROPIC_API_KEY=
# Create with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# For the bundled GitHub CLI (gh).
GH_TOKEN=

# --- Image ------------------------------------------------------------------
# CLAUDE_IMAGE=ghcr.io/thedeniz/claude-container:latest
# CONTAINER_NAME=claude

# --- Local builds only (docker-compose.build.yml) ---------------------------
# CLAUDE_VERSION=latest
# EXTRA_APT_PACKAGES="python3 nodejs"
